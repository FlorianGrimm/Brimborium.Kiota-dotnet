<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IsPackable>false</IsPackable>
    <NoWarn>NETSDK1138</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Brimborium.Kiota.csproj" />
    <TrimmerRootAssembly Include="Brimborium.Kiota.Abstractions" />
    <TrimmerRootAssembly Include="Brimborium.Kiota.Authentication.Azure" />
    <TrimmerRootAssembly Include="Brimborium.Kiota.Http.HttpClientLibrary" />
    <TrimmerRootAssembly Include="Brimborium.Kiota.Serialization.Form" />
    <TrimmerRootAssembly Include="Brimborium.Kiota.Serialization.Json" />
    <TrimmerRootAssembly Include="Brimborium.Kiota.Serialization.Text" />
  </ItemGroup>

</Project>